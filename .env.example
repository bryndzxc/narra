APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=narra
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# How long a running job may go without a heartbeat before the progress page
# calls it hung. Drop it to a minute to rehearse the alarm: kill a worker
# mid-job and watch /renders/<slug> go yellow.
# Where the finished MP4 is copied on a successful render, as <slug>.mp4.
# Absolute, and outside the project. Empty disables delivery entirely.
# The workspace keeps its own copy either way — Gate 3's player reads that one.
# --- YouTube channel defaults -------------------------------------------
# The upload settings that are the same on every video. They are rendered onto
# the Gate 4 publish sheet so the checklist states what to enter rather than
# only asking whether you did — a tick box that cannot name the value is a tick
# box you can only agree with, and it is how a video nearly went out as Gaming.
YOUTUBE_CATEGORY="People & Blogs"
YOUTUBE_VIDEO_LANGUAGE=en-US
YOUTUBE_CAPTION_LANGUAGE=en-US
YOUTUBE_MADE_FOR_KIDS=false
YOUTUBE_SYNTHETIC_CONTENT=true
YOUTUBE_SHORTS_REMIXING=false

RENDER_DELIVERY_PATH=
RENDER_DELIVERY_CREATE=true

RENDER_STALE_AFTER_MINUTES=15
RENDER_HEARTBEAT_SECONDS=30

# Which implementation each provider interface resolves to. Everything but the
# script writer defaults to `fake`, so nothing bills because a job got wired up
# early. Switching one on is a decision with a date on it.
PROVIDER_SCRIPT_WRITER=anthropic
PROVIDER_IMAGE_GENERATOR=fake
PROVIDER_REFERENCE_IMAGE_GENERATOR=fake
# Narration and word timings. These two were missing from this file entirely
# while both config keys already existed and both defaulted to `fake` — which is
# the same shape as the collision that ran 186 stills through a stand-in:
# PROVIDER_IMAGE_GENERATOR and PROVIDER_REFERENCE_IMAGE_GENERATOR read almost
# identically, only one was set, and nothing said so. A key that governs spend
# belongs in this file even when its value is `fake`.
PROVIDER_SPEECH_SYNTHESIZER=fake
PROVIDER_TRANSCRIBER=fake
# The publish sheet at Gate 4. Same vendor and same rate cards as the script
# writer, and defaulted the same way: it is text an operator reads at a gate,
# it costs cents, and a faked one would put placeholder copy on Gate 4 that
# looks generated.
PROVIDER_METADATA_WRITER=anthropic

# The narrator, stored per story so a channel keeps one voice across every
# video. Blank on purpose: it used to be hard-coded to `narrator-us-01`, which
# is a placeholder FakeSpeechSynthesizer invented and not a voice on any vendor.
# Pick a real one with `php artisan voices:list --set=<story> --voice=<id>`.
NARRATION_VOICE_ID=

# ElevenLabs Image & Video. Chosen over Leonardo for references-per-call: our
# scenes routinely have two or three named characters in frame, and Leonardo's
# Character Reference occupies one ControlNet slot per generation.
ELEVENLABS_API_KEY=
ELEVENLABS_IMAGE_MODEL=gemini-3.1-flash-image
ELEVENLABS_MAX_REFERENCES=14

# DECLARED, not returned by the provider — the generation response carries no
# cost field. Check these once against your usage page and correct them here;
# the Gate 2 sheet and `characters:sheets` both quote from them before spending.
ELEVENLABS_CREDITS_PER_IMAGE=240
ELEVENLABS_USD_PER_CREDIT=0.000165

# ElevenLabs text to speech. The narrator.
#
# PCM, not MP3, and this is not a quality preference. The render pipeline's
# exactness guarantee compares a probed duration against a decoded sample count,
# and for an MP3 those are different numbers — the decoder emits encoder delay
# the container never declared. 24 kHz because that is what the model actually
# generates; pcm_44100 is an upsample, is gated behind the Pro plan, and gets
# resampled by PadSceneAudio anyway.
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_OUTPUT_FORMAT=pcm_24000

# Half the credits per character, at a real cost in long-form stability. Worth
# knowing about when an allowance is tight:
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Consistency over expressiveness. A listener thirty minutes in notices a
# narrator who changes character between acts more than a flat read.
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75

# Hand the neighbouring scenes' text to the model as unspoken context so prosody
# carries across a scene boundary. OFF by default because ElevenLabs does not
# document whether that context is billed as characters, and a plan without
# overage STOPS rather than charging more. The provider records the
# `character-cost` response header, so one scene each way settles it.
ELEVENLABS_STITCH_CONTEXT=false

# Credits per character: 1.0 on the v2 multilingual models, 0.5 on flash/turbo.
# usd_per_credit is a PLAN rate — subscription over allowance — so it answers
# "did this fit in the plan" honestly and "what would this cost at scale" only
# loosely. Default is Starter: $6 / 30,000.
ELEVENLABS_USD_PER_CREDIT_TTS=0.0002

# WhisperX — local forced alignment, free. FORCED ALIGNMENT, not transcription:
# the narration is already known and approved at Gate 2, so the words are an
# INPUT and the model only decides where the boundaries fall. A recogniser that
# re-derived the text would occasionally mishear one, and a substituted word
# desynchronises the karaoke highlight for the rest of the scene while putting a
# word on screen nobody approved.
#
# MUST be an absolute path, and AlignerProbe refuses anything else rather than
# letting it fall back to a PATH lookup. PATH is a property of whoever started
# the process, so a bare `python` cannot mean the same thing in your shell and
# in a queue worker: on Windows it is usually the per-user App Execution Alias,
# which a service account does not have, and a Store-installed Python keeps its
# packages in that user's sandboxed LocalCache anyway. Leaving this on `python`
# once cost 181 alignments, all of them after the narration had been paid for.
#
# Find it by running this where alignment already works:
#   python -c "import whisperx, sys; print(sys.executable)"
WHISPERX_PYTHON=C:/path/to/python.exe
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8
WHISPERX_LANGUAGE=en
# Covers a cold start, not a warm one: every call re-imports torch and reloads
# the alignment model, and the first run on a machine also downloads it.
WHISPERX_TIMEOUT=600

# Candidate faces per character. A direct multiplier on the sheet's bill: one is
# a coin toss rather than a choice, and past four you are paying to pick between
# near-duplicates.
CHARACTER_CANDIDATES=4

# Must exceed the longest job on the queue (the mux runs for tens of minutes).
# Laravel's 90s default re-delivers a running mux to another worker.
REDIS_QUEUE_RETRY_AFTER=21600

# COMMAND Restart-Service NarraText, NarraAssets, NarraRender